# Copy this file to .env.local and fill in the values you want.
#
# Variables prefixed with VITE_ are inlined into the build at compile time.
# That means anything here is visible in the published JS — only use values
# that are safe to expose to the public (Google OAuth Client IDs are).

# Optional: enables Google Sign-In on the Me tab.
# See README.md → "Setting up Google Sign-In" for the OAuth setup steps.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
